<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.catalog.CatalogMapper">
  <resultMap id="CatalogItemMap" type="com.example.catalog.CatalogItem">
    <id property="id" column="id"/>
    <result property="name" column="name"/>
    <result property="status" column="status"/>
  </resultMap>

  <select id="findVisible" resultMap="CatalogItemMap">
    select id, name, status
    from catalog_item
    where status = #{status}
  </select>
</mapper>

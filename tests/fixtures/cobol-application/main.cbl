       IDENTIFICATION DIVISION.
       PROGRAM-ID. MAINPROG.
       ENVIRONMENT DIVISION.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT CUST-FILE ASSIGN TO "customers.dat".
       DATA DIVISION.
       FILE SECTION.
       FD CUST-FILE.
       01 CUST-REC PIC X(80).
       WORKING-STORAGE SECTION.
       COPY COMMON.
       01 WS-PROGRAM PIC X(8) VALUE "DYNAMIC".
       LOCAL-STORAGE SECTION.
       01 LOCAL-FLAG PIC 9 VALUE 0.
       LINKAGE SECTION.
       01 LINK-VALUE PIC X(10).
       PROCEDURE DIVISION.
       MAIN-PARA.
           PERFORM INIT-PARA THRU INIT-EXIT
           IF WS-STATUS = 0
               CALL "SUBPROG" USING WS-STATUS
           ELSE
               CALL WS-PROGRAM
           END-IF
           GO TO STEP-A STEP-B DEPENDING ON WS-STATUS.
       INIT-PARA.
           OPEN INPUT CUST-FILE
           READ CUST-FILE
           EXEC SQL
               SELECT NAME INTO :WS-NAME FROM CUSTOMER
           END-EXEC
           EXEC CICS LINK PROGRAM('SUBPROG') END-EXEC.
       INIT-EXIT.
           EXIT.
       STEP-A.
           ALTER STEP-B TO PROCEED TO INIT-EXIT.
       STEP-B.
           WRITE CUST-REC
           GOBACK.
       END PROGRAM MAINPROG.

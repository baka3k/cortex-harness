<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <add key="PublicMode" value="migration" />
    <add key="ApiToken" value="must-not-leak" />
  </appSettings>
  <connectionStrings>
    <add name="LegacyDb" connectionString="Server=localhost;User Id=admin;Password=must-not-leak" />
  </connectionStrings>
  <system.web>
    <authentication mode="Forms" />
    <sessionState mode="InProc" />
    <httpModules>
      <add name="Audit" type="LegacyWeb.AuditModule" />
    </httpModules>
  </system.web>
  <system.webServer>
    <handlers>
      <add name="LegacyHandler" path="legacy.ashx" verb="*" type="LegacyWeb.LegacyHandler" />
    </handlers>
  </system.webServer>
</configuration>

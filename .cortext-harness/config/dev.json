{
  "active": true,
  "project": {
    "code": "cortext",
    "name": "cortext"
  },
  "storage_backend": "remote",
  "code": {
    "env": {
      "GRAPH_PROVIDER": "falkordb",
      "CODE_GRAPH_PROVIDER": "falkordb",
      "FALKORDB_GRAPH": "cortext",
      "QDRANT_COLLECTION": "cortext",
      "EMBEDDING_MODEL": "Qwen/Qwen3-Embedding-0.6B",
      "BATCH_SIZE": "1",
      "MAX_EMBED_CHARS": "500",
      "device": "mps"
    },
    "source": {
      "projects": [
        {
          "git": "",
          "folder": [
            "~/AI/cortex-harness"
          ]
        }
      ]
    }
  },
  "doc": {
    "env": {
      "GRAPH_PROVIDER": "falkordb",
      "DOC_GRAPH_PROVIDER": "falkordb",
      "FALKORDB_GRAPH": "cortext_doc",
      "QDRANT_COLLECTION_DOC": "cortext_doc",
      "EMBEDDING_MODEL": "Qwen/Qwen3-Embedding-0.6B",
      "BATCH_SIZE": "1",
      "MAX_EMBED_CHARS": "500",
      "device": "mps"
    },
    "source": {
      "projects": [
        {
          "git": "",
          "folder": [
            "~/AI/cortex-harness"
          ]
        }
      ]
    }
  },
  "remote": {
    "qdrant_url": "http://localhost:6333",
    "falkordb_uri": "localhost:6379",
    "falkordb_ssl": false
  }
}

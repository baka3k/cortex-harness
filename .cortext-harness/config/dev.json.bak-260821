{
  "active": true,
  "project": {
    "code": "cortext",
    "name": "cortext"
  },
  "storage_backend": "remote",
  "code": {
    "env": {
      "GRAPH_PROVIDER": "falkordb",
      "CODE_GRAPH_PROVIDER": "falkordb",
      "FALKORDB_GRAPH": "cortext",
      "QDRANT_COLLECTION": "cortext",
      "EMBEDDING_MODEL": "jinaai/jina-embeddings-v3",
      "BATCH_SIZE": "1",
      "MAX_EMBED_CHARS": "500",
      "device": "cuda"
    },
    "source": {
      "projects": [
        {
          "git": "",
          "folder": [
            "C:\\ai\\cortex-harness\\"
          ]
        }
      ]
    }
  },
  "doc": {
    "env": {
      "GRAPH_PROVIDER": "falkordb",
      "DOC_GRAPH_PROVIDER": "falkordb",
      "FALKORDB_GRAPH": "cortext_doc",
      "EMBEDDING_MODEL": "BAAI/bge-m3",
      "BATCH_SIZE": "1",
      "MAX_EMBED_CHARS": "500",
      "device": "cuda"
    },
    "source": {
      "projects": [
        {
          "git": "",
          "folder": []
        }
      ]
    }
  },
  "remote": {
    "qdrant_url": "http://localhost:6333",
    "falkordb_uri": "localhost:6379",
    "falkordb_ssl": false
  }
}
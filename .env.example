# Example local MCP config

# Graph provider: falkordb (default) | neo4j | ladybug
DOC_GRAPH_PROVIDER=falkordb
# FalkorDB (remote server, Redis protocol); graph name per project is
# {project_id}_doc when resolved through the project registry.
FALKORDB_URI=localhost:6379
# FALKORDB_GRAPH=default_doc

# Neo4j — only used when DOC_GRAPH_PROVIDER=neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASS=your_password  # sensitive-guard:allow -- sample local default
NEO4J_DB=neo4j

QDRANT_URL=http://localhost:6333
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION_DOC=project_documents
QDRANT_COLLECTION_CODE="project_codes"

CODE_EMBEDDING_MODEL=jinaai/jina-embeddings-v3
TEXT_EMBEDDING_MODEL=BAAI/bge-m3

GLINER_MODEL_NAME=urchade/gliner_large-v2.1
#GLINER_MODEL_PATH=/Users/youruser/tool/ai/gliner_large-v2.1
HF_HUB_OFFLINE=0

EMBEDDING_DEVICE=cpu # cuda or mps or cpu

DEFAULT_ENTITY_TYPES=ORG,PRODUCT,STANDARD,TECH,CRYPTO,SECURITY,PROTOCOL,VEHICLE,DEVICE,SERVER,APP,CERTIFICATE,KEY
AZURE_OPENAI_API_KEY="xxxxxx"  # sensitive-guard:allow -- sample local placeholder
AZURE_OPENAI_ENDPOINT="xxxx"
AZURE_OPENAI_DEPLOYMENT="xxx"
AZURE_OPENAI_API_VERSION="xxx"
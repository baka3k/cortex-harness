# VB6 ANTLR worker (Maven aggregator) — ignore Maven build outputs.
# Source-of-truth: pom.xml, src/main, VENDOR.md, LICENSE inside
# code-tiny/tools/vb/antlr_worker/{vendor/proleap-vb6-parser,worker}/
code-tiny/tools/vb/antlr_worker/vendor/proleap-vb6-parser/target/**
code-tiny/tools/vb/antlr_worker/worker/target/**
# Eclipse IDE metadata (.project, .classpath, .settings) — local IDE
# state from antlr_worker builds, never to be tracked.
code-tiny/tools/vb/antlr_worker/.project
code-tiny/tools/vb/antlr_worker/.classpath
code-tiny/tools/vb/antlr_worker/.settings/**
code-tiny/tools/vb/antlr_worker/vendor/proleap-vb6-parser/.project
code-tiny/tools/vb/antlr_worker/vendor/proleap-vb6-parser/.classpath
code-tiny/tools/vb/antlr_worker/vendor/proleap-vb6-parser/.settings/**
code-tiny/tools/vb/antlr_worker/worker/.project
code-tiny/tools/vb/antlr_worker/worker/.classpath
code-tiny/tools/vb/antlr_worker/worker/.settings/**
# Backup / swap files left by ad-hoc edits in the antlr_worker.
code-tiny/tools/vb/antlr_worker/**/*.bak
# Track the prebuilt shaded jar so fresh clones can run `engine=antlr`
# without a Maven toolchain. `make build` re-stamps via ensure_worker_built()
# when sources change. Other Maven outputs (classes/, original-*.jar,
# generated-sources/) remain ignored.
!code-tiny/tools/vb/antlr_worker/worker/target/vb6-antlr-worker.jar
compile_commands.json
.qwen/tmp/**
.mimosa/
.mimosa/**
doc-tiny/http:/.localhost:6333.cortex-owner.lock
# YAKE dynamic entity-rule artifacts generated per project by doc sync
doc-tiny/rules/from-yake/

# --- Local harness working state (never commit) -------------------------
# Machine-local caches and generated facts produced by the harness itself.
# Anchored to the repository root so tracked packages such as
# ``cortex_harness.storage`` are never caught by these rules.
/.cortex/
/.cortex/**
/.cortext-harness/
/.cortext-harness/**

# sensitive terms blocklist — LOCAL ONLY (it names the terms it blocks)
.sensitive-terms
code-tiny/tools/vb/antlr_worker/worker/target/vb6-antlr-worker.jar

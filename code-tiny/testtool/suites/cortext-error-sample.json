          },
          "expected_status": "TOOL_ERROR",
          "expected_error_code": "missing_required_parameters"
        }
      ]
    },
    {
      "name": "mind_mcp",
      "endpoint": "http://127.0.0.1:8789/mcp",
      "require_full_inventory": false,
      "cases": [
        {
          "tool": "semantic_search",
          "input": {
            "query": "vector search latency optimization",
